{
  "name": "dsh-unity-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Unity 官方技能包（unity-agent-plugin）的 DSH 插件：把上游仓库的 Unity 技能整体接入 DSH，设置页单独分页，可逐个启用/禁用，并有「检查更新」一键从原仓库自动拉取最新内容。",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "skills",
    "upstream.json",
    "DSH-PLUGIN.md",
    "UPSTREAM-LICENSE.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "unity",
    "skill",
    "agent",
    "unity-agent-plugin"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
